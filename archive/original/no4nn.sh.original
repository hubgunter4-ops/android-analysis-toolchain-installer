#!/usr/bin/env bash
#
# install_android_analysis.sh
# ==============================================================================
# Instala en Ubuntu un set de herramientas para:
#   1) Ingeniería inversa de APKs (decompilar, desempaquetar, leer código)
#   2) Detección de comportamiento malicioso en APKs (análisis estático)
#   3) Monitoreo de procesos y conexiones de red en un dispositivo Android
#      conectado por USB (análisis dinámico, en vivo)
#
# Uso:
#   chmod +x install_android_analysis.sh
#   ./install_android_analysis.sh
#
# Requiere: Ubuntu 22.04/24.04+, sudo, conexión a internet.
# ==============================================================================

set -e

TOOLS_DIR="$HOME/security-tools"
mkdir -p "$TOOLS_DIR"

echo "=== [1/6] Dependencias base ==="
sudo apt update
sudo apt install -y \
    build-essential git curl wget unzip python3 python3-pip python3-venv \
    default-jdk

# ------------------------------------------------------------------------- #
echo "=== [2/6] Conexión y control del dispositivo (ADB) ==="
sudo apt install -y android-tools-adb android-tools-fastboot

echo "  -> Verifica el dispositivo con: adb devices"
echo "  -> Requiere 'Depuración USB' activada en Opciones de Desarrollador del Android"

# ------------------------------------------------------------------------- #
echo "=== [3/6] Descompilación / desempaquetado de APK ==="
sudo apt install -y apktool

# JADX - decompilador de Java/Kotlin desde bytecode DEX, con GUI y CLI
if [ ! -d "$TOOLS_DIR/jadx" ]; then
    JADX_URL=$(curl -s https://api.github.com/repos/skylot/jadx/releases/latest \
        | grep browser_download_url | grep '\-all\.zip"' | head -1 | cut -d '"' -f 4)
    if [ -n "$JADX_URL" ]; then
        wget -O /tmp/jadx.zip "$JADX_URL"
        unzip -q /tmp/jadx.zip -d "$TOOLS_DIR/jadx"
        rm /tmp/jadx.zip
        chmod +x "$TOOLS_DIR"/jadx/bin/*
        echo "  -> jadx instalado en $TOOLS_DIR/jadx (usar: $TOOLS_DIR/jadx/bin/jadx-gui)"
    fi
fi

# dex2jar - convierte .dex a .jar para inspeccionar con cualquier decompilador Java
if [ ! -d "$TOOLS_DIR/dex2jar" ]; then
    git clone --depth 1 https://github.com/pxb1988/dex2jar.git "$TOOLS_DIR/dex2jar"
fi

# ------------------------------------------------------------------------- #
echo "=== [4/6] Detección de comportamiento malicioso (análisis estático) ==="
pip3 install --user --break-system-packages \
    androguard \
    quark-engine \
    apkid

echo "  -> androguard: framework Python para analizar permisos, componentes y firmas del APK"
echo "  -> quark-engine: motor de reglas para PUNTUAR comportamiento malicioso de un APK"
echo "  -> apkid: detecta packers/ofuscadores/compiladores usados (común en malware)"

# MobSF - Mobile Security Framework: análisis estático + dinámico con interfaz web
if [ ! -d "$TOOLS_DIR/MobSF" ]; then
    git clone --depth 1 https://github.com/MobSF/Mobile-Security-Framework-MobSF.git "$TOOLS_DIR/MobSF"
    echo "  -> Para instalar MobSF: cd $TOOLS_DIR/MobSF && ./setup.sh"
    echo "     Luego ejecutar con: ./run.sh (interfaz web en http://127.0.0.1:8000)"
fi

# ------------------------------------------------------------------------- #
echo "=== [5/6] Análisis dinámico e instrumentación en vivo ==="
pip3 install --user --break-system-packages \
    frida-tools \
    objection

echo "  -> objection: se inyecta en la app en ejecución (sin root, vía frida) para"
echo "     ver en vivo qué hace: llamadas de red, lecturas de archivos, uso de APIs"

# ------------------------------------------------------------------------- #
echo "=== [6/6] Captura y análisis de tráfico de red ==="
sudo apt install -y wireshark tcpdump
sudo usermod -aG wireshark "$USER" 2>/dev/null || true

pip3 install --user --break-system-packages mitmproxy

echo "  -> mitmproxy: proxy HTTP(S) para interceptar y ver el tráfico del dispositivo"
echo "     (configúralo como proxy WiFi del Android e instala su certificado)"

echo ""
echo "=================================================================="
echo " Instalación completa. Resumen de herramientas:"
echo ""
echo " ESTÁTICO (analizar el .apk sin ejecutarlo):"
echo "   apktool, jadx, dex2jar, androguard, quark-engine, apkid, MobSF"
echo ""
echo " DINÁMICO (dispositivo conectado y app en ejecución):"
echo "   adb, frida-tools, objection, mitmproxy, wireshark, tcpdump"
echo ""
echo " Herramientas manuales en: $TOOLS_DIR"
echo "=================================================================="
